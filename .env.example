# ---------------------------------------------------------------------------
# Configuracion de la plataforma OKF.
#
# IMPORTANTE: este fichero NO es necesario para arrancar. Todos los valores
# tienen un default en docker-compose.yml con la forma ${VAR:-default}, de modo
# que `git clone && docker compose up --build` funciona sin ningun paso previo.
# Copie a .env solo si quiere sobreescribir algo:  cp .env.example .env
#
# Las variables son DISCRETAS (host/puerto/usuario/clave por separado) y no
# cadenas de conexion: una contrasena con @ / : # ? romperia el parseo de una URL.
# ---------------------------------------------------------------------------

APP_ENV=dev                 # dev | prod   (en prod la validacion de config es estricta)
LOG_LEVEL=info              # debug | info | warn | error

# --- Puerto publico (unico expuesto al host) -------------------------------
EDGE_PORT=8080

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=okf
POSTGRES_PASSWORD=okf_dev_password
POSTGRES_DB=okf
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10

# --- RabbitMQ --------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=okf
RABBITMQ_PASSWORD=okf_dev_password
RABBITMQ_VHOST=/
RABBITMQ_PREFETCH=1
# Consola de gestion (solo para la demostracion del video)
RABBITMQ_MANAGEMENT_PORT=15672

# --- MinIO (almacenamiento de objetos) -------------------------------------
S3_ENDPOINT=minio:9000
S3_ACCESS_KEY=okfadmin
S3_SECRET_KEY=okfadmin_dev_password
S3_USE_SSL=false
S3_BUCKET_ORIGINALS=okf-originals
S3_BUCKET_BUNDLES=okf-bundles
# Consola web de MinIO (solo para la demostracion del video)
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# --- Autenticacion ---------------------------------------------------------
# En prod DEBE definirse explicitamente (>= 32 bytes).
# Generar en Windows PowerShell 5.1:
#   $b=New-Object byte[] 48; ([Security.Cryptography.RNGCryptoServiceProvider]::new()).GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=dev-secret-cambiar-en-produccion-min-32-bytes
JWT_TTL=24h
DOWNLOAD_TICKET_TTL=120s
DOWNLOAD_TICKET_MAX_USES=3

# --- Limites de ingesta (documentos NO confiables) -------------------------
MAX_UPLOAD_BYTES=20971520     # 20 MiB  - rechaza con 413, nunca trunca
PARSE_MAX_BYTES=5242880       #  5 MiB  - tope del parseo (peor caso cuadratico)
MAX_BUNDLE_BYTES=67108864     # 64 MiB
ASSETS_MAX_BYTES=16777216     # 16 MiB
MAX_UNITS=500
ZIP_MAX_ENTRIES=2000
ZIP_MAX_RATIO=100             # proteccion frente a zip bombs

# --- Worker ----------------------------------------------------------------
# Soporte de PDF. Requiere poppler-utils, que ya viene en la imagen del worker.
# La API lo rechaza en la carga si esta desactivado, en lugar de aceptarlo y
# fallar despues en el worker.
ENABLE_PDF=true

WORKER_CONCURRENCY=1
JOB_TIMEOUT=120s              # presupuesto de conversion por trabajo
JOB_LEASE=180s                # > JOB_TIMEOUT + margen de subida
SWEEPER_INTERVAL=30s
SWEEPER_STALE_AFTER=60s
MAX_ATTEMPTS=3
RETRY_DELAY=30s

# --- Demostracion ----------------------------------------------------------
# Retardo artificial. Por defecto 0: la evidencia de asincronia (C1) es el
# documento grande real. Si se activa, el worker lo declara explicitamente en
# log.md y en la linea de tiempo del trabajo. Nunca es evidencia oculta.
DEMO_SLOW_MODE_MS=0

# Herramientas de demostracion (endpoint /jobs/{id}/replay para C6).
# Sigue exigiendo autenticacion Y propiedad del recurso.
DEV_TOOLS=false

# Inyeccion de fallo para demostrar la condicion literal "ante la ausencia de
# index.md o log.md, la validacion falla". Vacio = desactivado.
# Valores: drop_index | drop_log
#
# Un bundle generado correctamente nunca le falta un fichero obligatorio, asi que
# el caso hay que provocarlo. Cuando se activa, el worker deja una etapa
# 'fault_inject' explicita en la cronologia del trabajo: la manipulacion es
# visible y no se presenta como un fallo espontaneo. La evidencia principal de
# validacion sigue siendo testdata/04-invalido.txt, que falla por causa natural.
OKF_FAULT_INJECT=
